# Supabase-Zugangsdaten (lokal: Ausgabe von `supabase status`)
# Lokale Entwicklung: supabase start && supabase status
# Hinweis: interestsect nutzt lokal Port 55321 (553xx-Bereich), damit andere
# lokale Supabase-Projekte (Standard 54321) parallel laufen können.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Google Places API (New) — Regionsuche im Profil (optional; ohne Key liefert die
# Suche einfach keine Vorschläge). Key nur serverseitig, nie im Browser.
GOOGLE_PLACES_API_KEY=dein-google-places-key
