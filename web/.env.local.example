# Supabase-Zugangsdaten des Cloud-Projekts (Frankfurt)
# Supabase-Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Google Places API (New) — Regionsuche im Profil (optional; ohne Key liefert die
# Suche einfach keine Vorschläge). Key nur serverseitig, nie im Browser.
GOOGLE_PLACES_API_KEY=dein-google-places-key
